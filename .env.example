# ==============================================================
# Bhabachyaka Express - Environment Configuration
# ==============================================================

# Database Connection (Default Local SQLite or Supabase PostgreSQL)
# For Local SQLite:
DATABASE_URL="file:./dev.db"

# For Supabase PostgreSQL:
# 1. Transaction Pooler (for Next.js / Serverless API routes - Port 6543)
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# 2. Session / Direct connection (for Prisma Migrations & Schema push - Port 5432)
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Project API Credentials (from Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Auth Secret
JWT_SECRET="bhabachyaka-express-super-secret-key-prod-2026"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_APP_NAME="ভ্যাবাচ্যাকা এক্সপ্রেস"
NEXT_PUBLIC_APP_NAME_EN="BHABACHYAKA EXPRESS"
NODE_ENV="development"

# Optional Live Payment Gateway Credentials (when moving from DEMO mode to Production)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASS=""
